---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';

import Modal from '../components/ui/Modal.astro';

import '../styles/global.css';
import '../styles/base.css';
import '../styles/components.css';

import '../styles/hero.css';
import '../styles/projects.css';
import '../styles/timeline-layout.css';
import '../styles/education.css';
import '../styles/certificates.css'
import '../styles/events.css';
import '../styles/skills.css';
import "../styles/contact-form.css";

import '../styles/flip-card.css';
import '../styles/card.css';

import '../styles/carousel/carousel-shared.css';
import '../styles/carousel/carousel-2d.css';
import '../styles/carousel/carousel-3d.css';

import { getSafeLang, useTranslations } from '../i18n/utils';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';

const lang = getSafeLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const currentPath = Astro.url.pathname;
const alternateLocales = (Object.keys(languages) as Lang[]);

export interface Props {
  title?: string;
}

const { title = t('meta.title') } = Astro.props;

---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- para que buscadores sepan que /en/ y /es/ son la misma página en distintos idiomas.
     Sin esto, Google puede indexarlas como contenido duplicado. -->
    {alternateLocales.map((altLang) => (
        <link rel="alternate" hreflang={altLang} href={getAbsoluteLocaleUrl(altLang, currentPath)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', currentPath)} />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />
</head>
<body>
    <!-- Header compartido -->
    <Header />
    
    <!-- Contenido de cada página -->
    <main>
        <slot />
    </main>

    <Modal />

    <!-- JavaScript Global -->
    <script src="../scripts/main.js"></script>
</body>
</html>