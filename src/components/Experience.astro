---
// src/components/Experience.astro

import { render, getCollection } from 'astro:content';
import TimeLineCard from './ui/cards/TimeLineCard.astro';

import { useTranslations, getSafeLang } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);

// Para cargar los .md según el idioma actual, se utiliza getSafeLang para obtener el 
// idioma seguro y luego se filtra la colección de experiencia para que solo incluya 
// las entradas que comienzan con el idioma actual
const lang = getSafeLang(Astro.currentLocale);
const allExperience = await getCollection('experience', (entry) =>
  entry.id.startsWith(`${lang}/`)
);
---

<section id="experience" class="fade-in">
    <h2 class="section-title">{t('nav.experience')}</h2>

    <div class="timeline-list">
        {allExperience.map(async (experience, index) => {
            const { Content } = await render(experience);
            return (
                <TimeLineCard
                    header={experience.data.company}
                    entity={experience.data.role}
                    duration={experience.data.duration}
                    location={experience.data.location}
                    title={experience.data.title}
                    description={experience.data.description}
                    stack={experience.data.stack}
                    github={experience.data.github}
                    demo={experience.data.demo}
                    viewUrl={experience.data.website}
                    image={experience.data.image}
                    animationDelay={index * 0.2} 
                >
                    <Content />
                </TimeLineCard>
            );
        })}
    </div>
</section>