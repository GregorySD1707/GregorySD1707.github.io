---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import profileImage from '../assets/images/Foto_CV-sin_fondo.webp';
import ActionElement from './ui/ActionElement.astro';
import { Icon } from 'astro-icon/components';

import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);

import { getSafeLang } from '../i18n/utils';
const lang = getSafeLang(Astro.currentLocale);
const cvUrl = `${import.meta.env.BASE_URL}documents/cv/${lang}/Gregory_Salazar-CV.pdf`;
const linkedinUrl = "https://www.linkedin.com/in/gsalazar17/" + (lang === 'en' ? "?locale=en-US" : "");
---

<section id="home" class="hero">
    <div class="hero-image fade-in">
        <div class="profile-img-container">
            <Image 
            src={profileImage} 
            alt="Gregory Salazar" 
            class="profile-img"
            />
        </div>
    </div>

    <div class="hero-content fade-in" style="transition-delay: 0.1s;">
        <div class="kicker-group">
            <span class="kicker">{t('hero.kicker')}</span>
            <h1 class="headline">Gregory Salazar</h1>
        </div>

        <div class="roles">
            <span>{t('hero.roles.student')}</span>
            <span>{t('hero.roles.developer')}</span>
        </div>

        <p class="description">
            {t('hero.description')}
        </p>

        <div class="actions">
            <ActionElement variant="primary" iconPosition="left" text={t('action.downloadCv')} href={cvUrl}>
                <Icon slot="icon" name="mdi:download" />
            </ActionElement>
            <div class="external-links">
                <ActionElement variant="inline" iconPosition="top" text="GitHub" href="https://github.com/GregorySD1707">
                    <Icon slot="icon" name="mdi:github" />
                </ActionElement>

                <ActionElement variant="inline" iconPosition="top" text="LinkedIn" href={linkedinUrl}>
                    <Icon slot="icon" name="mdi:linkedin" />
                </ActionElement>

                <ActionElement variant="inline" iconPosition="top" text="Email" href="mailto:gregory.sd.17@gmail.com">
                    <Icon slot="icon" name="mdi:email" />
                </ActionElement>
                
            </div>
        </div>
    </div>
</section>