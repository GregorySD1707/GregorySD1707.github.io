---
// src/components/ui/LanguageSwitcher.astro
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import { getSafeLang } from '../i18n/utils';

const currentLang = getSafeLang(Astro.currentLocale);
const otherLang: Lang = currentLang === 'en' ? 'es' : 'en';

const pathWithoutLocale = Astro.url.pathname.replace(new RegExp(`^/${currentLang}/?`), '/');
const targetHref = getRelativeLocaleUrl(otherLang, pathWithoutLocale);
---
<a href={targetHref}>{languages[otherLang]}</a>