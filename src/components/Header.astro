---
// src/components/Header.astro
import { useTranslations, getSafeLang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from '../components/ui/LanguageSwitcher.astro';

const t = useTranslations(Astro.currentLocale);
const homeHref = getRelativeLocaleUrl(getSafeLang(Astro.currentLocale), '/');
---
<header class="fade-in">
    <a href={homeHref} class="logo">Gregory SD</a>
    <nav id="nav-menu">
        <a href="#home">{t('home.name')}</a>
        <a href="#experience">{t('experience.name')}</a>
        <a href="#projects">{t('projects.name')}</a>
        <a href="#education">{t('education.name')}</a>
        <a href="#certificates">{t('certificates.name')}</a>
        <a href="#events">{t('events.name')}</a>
        <a href="#skills">{t('skills.name')}</a>
        <a href="#contact">{t('contact.name')}</a>
    </nav>
    <LanguageSwitcher />
</header>