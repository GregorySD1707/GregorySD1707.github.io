---
// src/components/ui/ActionElement.astro
interface Props {
  text: string;
  href?: string;
  variant: 'primary' | 'ghost' | 'inline';
  iconPosition?: 'left' | 'right' | 'top' | 'bottom';
  customClass?: string;
  download?: boolean;
}

const { 
  text, 
  href, 
  variant, 
  iconPosition = 'left', 
  customClass = '',
  download = false, 
} = Astro.props;

const Element = href ? 'a' : 'button';

// Map variants to CSS classes
const variantClasses = {
  primary: 'btn-primary',
  ghost: 'btn-ghost',
  inline: 'link-inline'
};

const layoutClass = `icon-${iconPosition}`;
const selectedClass = variantClasses[variant];
---

<Element 
    href={href} 
    class={`${selectedClass} ${layoutClass} ${customClass}`} 
    {...(href ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    {...(download ? { download: true } : {})}
>
    <slot name="icon" />
    <span class="action-text">{text}</span>
</Element>