---
/* src/components/ui/Modal.astro */
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(Astro.currentLocale);
---
<dialog id="global-modal" class="global-modal" aria-labelledby="modal-title" aria-describedby="modal-message">
  <div class="modal-content">
    <div id="modal-icon" class="modal-icon" aria-hidden="true">
      <Icon name="mdi:check" class="meta-icon" id="icon-success" style="display: none;" />
      <Icon name="mdi:close" class="meta-icon" id="icon-error" style="display: none;" />
      <Icon name="mdi:alert" class="meta-icon" id="icon-warning" style="display: none;" />
      <Icon name="mdi:information" class="meta-icon" id="icon-info" style="display: none;" />
    </div>
    <h3 id="modal-title"></h3>
    <p id="modal-message"></p>
    <!-- texto inicial que existe en el DOM antes de que JavaScript interactúe con el elemento -->
    <button type="button" id="modal-close-btn" class="btn-primary">{t('modal.button.accept')}</button>
  </div>
</dialog>

<script>
  import { initModal } from '../../scripts/modal';
  initModal();
</script>