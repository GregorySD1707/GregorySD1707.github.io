---
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  icon: string | ImageMetadata;
  animationDelay?: number;
}

const { name, icon, animationDelay = 0 } = Astro.props;

// Verificamos si es una imagen webp local o un string de astro-icon
const isLocalImage = typeof icon !== 'string';
---

<div class="skill-card fade-in" style={`--delay: ${animationDelay}s`}>
    <div class="skill-inner">
        {isLocalImage ? (
            <img src={(icon as ImageMetadata).src} alt={name} class="skill-icon" />
        ) : (
            <Icon class="skill-icon" name={icon as string} />
        )}
        <span class="skill-name">{name}</span>
    </div>
</div>