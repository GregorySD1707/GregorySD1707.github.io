---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ActionElement from '../ActionElement.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  header: string;
  entity: string;
  duration: string;
  location?: string;
  title?: string;
  description?: string;
  stack?: string[];
  github?: string;
  demo?: string;
  image?: ImageMetadata;
  imagePosition?: 'left' | 'right' | 'top' | 'bottom';
  animationDelay?: number;
  fallbackIcon?: string;
  isEducation?: boolean;
}

const {
  header, entity, duration, location,
  title, description, stack = [], github, demo, image,
  imagePosition = 'left',
  animationDelay = 0,
  fallbackIcon = 'mdi:briefcase',
  isEducation = false,
} = Astro.props;

const hasProject = Boolean(title || description || stack.length || github || demo);
---

<article class={`timeline-card image-${imagePosition} ${isEducation ? 'is-education' : ''} fade-in`} style={`transition-delay: ${animationDelay}s`}>
    <span class="timeline-dot"></span>

    <div class="timeline-content">
        <div class="timeline-image-container">
            {image ? (
                <>
                    <Image src={image} alt="" loading="lazy" class="timeline-img-bg" />
                    <Image src={image} alt={header} loading="lazy" class="timeline-img" />
                </>
            ) : (
                <div class="timeline-image-placeholder">
                    <Icon name={fallbackIcon} />
                </div>
            )}
        </div>

        <div class="timeline-info">
            <div class="timeline-header">
                <h3>{header}</h3>
            </div>

            {hasProject && (
                <div class="timeline-project">
                    {title && <h4>{title}</h4>}
                    {description && <p class="pitch">{description}</p>}
                    {stack.length > 0 && (
                        <div class="tech-stack">
                            {stack.map((item) => <span class="tech-tag">{item}</span>)}
                        </div>
                    )}
                </div>
            )}

            <div class="timeline-metadata">
                <div class="meta-item">
                    <Icon class="meta-icon" name="mdi:account" />
                    <span>{entity}</span>
                </div>
                <div class="meta-item">
                    <Icon class="meta-icon" name="mdi:calendar" />
                    <span>{duration}</span>
                </div>
                {location && (
                    <div class="meta-item">
                        <Icon class="meta-icon" name="mdi:map-marker" />
                        <span>{location}</span>
                    </div>
                )}
            </div>
            
            <div class="achievements-list">
                <slot /> <!-- bullets del Markdown, siempre visibles -->
            </div>

            {(github || demo) && (
                 <div class="card-actions row-layout">
                    <div class="external-links">
                        {github && (
                            <ActionElement variant="inline" iconPosition="top" text="GitHub" href={github}>
                                <Icon slot="icon" name="mdi:github" />
                            </ActionElement>
                        )}
                        {demo && (
                            <ActionElement variant="inline" iconPosition="top" text="Demo" href={demo}>
                                <Icon slot="icon" name="mdi:play" />
                            </ActionElement>
                        )}
                    </div>
                </div>
            )}
            
        </div>
    </div>
</article>