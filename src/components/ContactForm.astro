---
// src/components/ContactForm.astro

import { contactReasons } from "../content/contact/reasons";
import { useTranslations, getSafeLang, localizeText } from '../i18n/utils';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const t = useTranslations(Astro.currentLocale);
const lang = getSafeLang(Astro.currentLocale);
---

<section id="contact" class="fade-in">
  <div class="form-container">
    <h2 class="section-title">{t('contact.name')}</h2>

    <form
      id="contact-form"
      class="custom-form"
      method="POST"
      data-web3form
      aria-busy="false"
      novalidate
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input
        type="hidden"
        name="subject"
        id="form-subject"
        value={t('input.default-subject')}
      />
      <input type="hidden" name="from_name" value={t('input.default-from_name')} />

      <input
        type="checkbox"
        name="botcheck"
        class="honeypot"
        tabindex="-1"
        autocomplete="off"
      />

      <fieldset class="reason-group">
        <legend class="required">{t('contact.label.reason')}</legend>
        <div class="radio-wrapper">
          {
            contactReasons.map((reason, index) => (
              <label class="radio-label">
                <input
                  type="radio"
                  name="reason"
                  value={reason.id}
                  required
                  checked={index === 0}
                  data-reason-config={JSON.stringify(reason)}
                />
                {localizeText(reason.label, lang)}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field-group">
        <label for="name" class="required">{t('contact.label.name')}</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder={t('contact.placeholder.name')}
          autocomplete="name"
          aria-describedby="error-name"
        />
        <span class="field-error" id="error-name" aria-live="polite"></span>
      </div>

      <div class="field-group">
        <label for="email" class="required">{t('contact.label.email')}</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder={t('contact.placeholder.email')}
          autocomplete="email"
          aria-describedby="error-email"
        />
        <span class="field-error" id="error-email" aria-live="polite"></span>
      </div>

      <!-- Campo Extra: Company (Solo para laboral) -->
      <div
        class="field-group extra-field"
        data-extra-for="company"
        style="display: none;"
      >
        <label for="company_name" class="required">{t('contact.label.company')}</label>
        <input
          type="text"
          id="company_name"
          name="company_name"
          placeholder={t('contact.placeholder.company')}
          aria-describedby="error-company_name"
        />
        <span class="field-error" id="error-company_name" aria-live="polite"
        ></span>
      </div>

      <div class="field-group textarea-wrapper">
        <label for="message" class="required">{t('contact.label.message')}</label>
        <textarea
          id="message"
          name="message"
          maxlength="500"
          required
          aria-describedby="error-message char-counter"
          class="custom-scrollbar"
          ></textarea>

        <!-- Contenedor flex para alinear error a la izquierda y contador a la derecha -->
        <div class="textarea-footer">
          <span class="field-error" id="error-message" aria-live="polite"
          ></span>
          <span class="char-counter" id="char-counter" data-counter-for="message">0 / 500</span>
        </div>
      </div>

      <p class="form-status" data-form-status aria-live="polite"></p>
      <button type="submit" class="btn-primary" data-form-submit
        >{t('contact.send_message')}</button
      >
    </form>
  </div>
</section>

<script>
  import { setupFormHandler } from "../scripts/formHandler";
  const forms = document.querySelectorAll<HTMLFormElement>(
    "form[data-web3form]",
  );
  forms.forEach((form) => setupFormHandler(form));
</script>
