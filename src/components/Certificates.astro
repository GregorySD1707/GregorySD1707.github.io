---
import { getCollection } from 'astro:content';
import TimeLineCard from './ui/cards/TimeLineCard.astro';
import { useTranslations, getSafeLang } from '../i18n/utils';

const lang = getSafeLang(Astro.currentLocale);
const allCertificates = await getCollection('certificates', entry => entry.id.startsWith(`${lang}/`));
const t = useTranslations(Astro.currentLocale);
---

<section id="certificates" class="fade-in">
    <h2 class="section-title">{t('certificates.name')}</h2>

    <div class="certificates-grid">
        {allCertificates.map((certificate, index) => {
            const { title, issuer, issueDate, expirationDate, image, pdf } = certificate.data;
            const dateLine = expirationDate
                ? `Issued: ${issueDate} · Expires: ${expirationDate}`
                : `${issueDate}`;
            const documentUrl = `${import.meta.env.BASE_URL}documents/certificates/${pdf}`;

            return (
                <TimeLineCard
                    header={title}
                    entity={issuer}
                    duration={dateLine}
                    image={image}
                    imagePosition="top"
                    
                    showConnector={false}
                    viewUrl={documentUrl}
                    downloadUrl={documentUrl}
                    animationDelay={index * 0.1}
                />
            );
        })}
    </div>
</section>