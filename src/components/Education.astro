---
import { render, getCollection } from 'astro:content';
import TimeLineCard from './ui/cards/TimeLineCard.astro';
import { useTranslations, getSafeLang } from '../i18n/utils';

const lang = getSafeLang(Astro.currentLocale);
const allEducation = await getCollection('education', (entry) =>
  entry.id.startsWith(`${lang}/`)
);
const t = useTranslations(Astro.currentLocale);
---

<section id="education" class="fade-in">
    <h2 class="section-title">{t('education.name')}</h2>

    <div class="timeline-list">
        {allEducation.map(async (education, index) => {
            const { Content } = await render(education);
            
            // Reusing TimeLineCard maps perfectly to Education data without duplicating code
            return (
                <TimeLineCard
                    header={education.data.institution}
                    entity={education.data.degree}
                    duration={education.data.duration}
                    location={education.data.location}
                    animationDelay={index * 0.2} 
                    fallbackIcon="mdi:school"
                    imagePosition="top"
                    image={education.data.image}
                    isCentered={true}
                >
                    <Content />
                </TimeLineCard>
            );
        })}
    </div>
</section>